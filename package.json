{
  "name": "dorkfi-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for the DorkFi lending protocol on Voi and Algorand",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "audit": "node scripts/audit.js",
    "audit:account": "node scripts/audit.js --mode account",
    "audit:staleness": "node scripts/audit.js --mode staleness",
    "audit:summary": "node scripts/audit.js --mode summary",
    "sync:position": "node scripts/sync-position.js",
    "sync:deposit-only": "node scripts/sync-position.js --deposit-only",
    "sync:deposit-only-market": "node scripts/sync-position.js --deposit-only",
    "notify": "node scripts/notify.js",
    "send:liquidation-warning": "node scripts/notify.js --mode send-one",
    "broadcast:notification": "node scripts/notify.js --mode broadcast",
    "generate:notification-commands": "node scripts/notify.js --mode plan"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "algosdk": "^3.5.2",
    "dotenv": "^17.3.1",
    "ulujs": "^3.0.2",
    "zod": "^3.23.0"
  }
}
